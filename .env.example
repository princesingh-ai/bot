# ==============================================================================
# CRIEYA Chatbot Environment Configuration
# Copy this file to .env and configure the values for your environment.
# ==============================================================================

# SarvamAI API Key (Required for agent LLM completions)
SARVAM_API_KEY=your_sarvam_api_key_here

# Application Environment (development | production)
ENVIRONMENT=production

# Server Network Configuration
HOST=0.0.0.0
PORT=8000

# FastMCP Datastore Service Configuration
MCP_HOST=127.0.0.1
MCP_PORT=9000
MCP_SERVER_URL=http://127.0.0.1:9000/sse
MCP_CONNECT_TIMEOUT_SECONDS=30.0
MCP_MAX_RETRIES=5

# CORS Configuration (comma-separated list of allowed origins, or * for all)
# Example for production: https://crieya.yourdomain.com,https://your-frontend.com
CORS_ORIGINS=*

# Security Guardrails
MAX_QUERY_LENGTH=2000
